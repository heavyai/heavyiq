{
  "name": "HeavyIQ Development",
  // Use docker-compose
  "dockerComposeFile": "../docker/docker-compose.ubuntu.yml",
  "service": "heavyiq",
  "workspaceFolder": "/code",
  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  // VS Code extensions to install in the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3.11",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "editor.rulers": [
          120
        ]
      }
    }
  },
  // Ports to forward
  "forwardPorts": [
    6275,
    8000
  ],
  // Run commands after container is created
  "postCreateCommand": "pip install -r requirements.txt && pip install -r requirements-dev.txt || true",
  // Run commands after container starts
  "postStartCommand": "echo 'Dev container ready! Run: gunicorn -w 4 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:6275 --preload \"heavyiq.api:create_app('config.toml')\"'"
  // User to run as (optional - comment out to run as root)
  // "remoteUser": "vscode"
}