{
  "editor.fontSize": 14,
  "python.defaultInterpreterPath": ".venv/bin/python",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.venv": true,
    "**/.my*": true,
    "**/__pycache__": true
  },
  "editor.formatOnSave": true,
  "mypy-type-checker.cwd": "${workspaceFolder}/heavyrag",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "black-formatter.cwd": "${workspaceFolder}/heavyrag"
}
